# ── Python 缓存 ──
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ── 运行时数据库（启动自动重建，不入库）──
*.db
*.sqlite
*.sqlite3

# ── 虚拟环境 ──
venv/
.venv/
env/
.venv*/

# ── 前端依赖与构建产物 ──
node_modules/
dist/
build/

# ── 编辑器/IDE ──
.idea/
.vscode/
*.swp

# ── 日志 ──
*.log

# ── 本地环境变量（可能含真实密钥，绝不入库；.env.example 除外）──
.env
.env.*
!.env.example
