# HealthPick 环境变量示例（全部可选，零配置即可本地规则模式运行）
# 复制为 backend/.env 后按需填写；切勿把真实 Key 提交进版本库。

# ── 运行环境 ──
HEALTHPICK_ENV=dev
HEALTHPICK_HOST=0.0.0.0
HEALTHPICK_PORT=8000

# ── 数据库（默认本地 SQLite，可切 Postgres）──
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/healthpick

# ── LLM（进阶2：动态调用；留空则纯本地规则降级，永不裸奔）──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── 审计账本 HMAC（留空则仅哈希链、无签名）──
AUDIT_HMAC_KEY=

# ── 网关边界 ──
HEALTHPICK_MAX_MESSAGE_LEN=500
HEALTHPICK_RATE_LIMIT_PER_MIN=60

# ── CORS 白名单（逗号分隔；prod 禁用 *）──
# HEALTHPICK_CORS_ORIGINS=http://127.0.0.1:8137
